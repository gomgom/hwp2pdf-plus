<?xml version="1.0" encoding="utf-8"?>
<!--
  hwp2pdf+ 메인 창.
  x:Class 없이 작성해 XamlReader.Load 로 런타임 파싱한다(코드비하인드 컴파일 불필요 → csc 단일 빌드 유지).
  컨트롤은 x:Name 으로 찾아 Program.cs 에서 이벤트를 연결한다.
  색상은 모두 DynamicResource — Program.cs 가 시스템 라이트/다크 테마에 맞춰 주입한다.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="hwp2pdf+ — HWP → PDF 일괄 변환기"
        Width="820" Height="640" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Malgun Gothic, Segoe UI"
        FontSize="13"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Fg}">

  <Window.Resources>

    <!-- ── 아이콘 글꼴 ── -->
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── 기본(강조) 버튼 ── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{DynamicResource Accent}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DisabledBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgSubtle}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 보조(고스트) 버튼 ── -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{DynamicResource GhostBg}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GhostHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GhostPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 토글 스위치 (CheckBox 재템플릿) ── -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="38" Height="21" CornerRadius="11"
                      Background="{DynamicResource TrackBg}"
                      BorderBrush="{DynamicResource TrackBorder}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Ellipse x:Name="thumb" Width="15" Height="15" Fill="{DynamicResource ThumbFill}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                         RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumb"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       To="17" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumb"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       To="0" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 얇은 스크롤바 ── -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Background="{DynamicResource ScrollThumb}" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 진행률 막대 ── -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="3" Background="{DynamicResource TrackBg}" ClipToBounds="True">
              <Grid>
                <Rectangle x:Name="PART_Track"/>
                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                           RadiusX="3" RadiusY="3" Fill="{DynamicResource Accent}"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 목록 행 ── -->
    <Style x:Key="FileRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" CornerRadius="7" Background="Transparent" Padding="12,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowSelected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── 목록 행 내용 (파일명 / 경로 / 상태 배지) ── -->
    <DataTemplate x:Key="FileTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="19"
                   Foreground="{DynamicResource FgSubtle}" Margin="0,0,12,0"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Folder}" FontSize="11" Margin="0,2,0,0"
                     Foreground="{DynamicResource FgSubtle}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border x:Name="badge" Grid.Column="2" CornerRadius="10" Padding="11,4" Margin="12,0,0,0"
                VerticalAlignment="Center" Background="{DynamicResource IdleBg}">
          <TextBlock x:Name="badgeText" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource IdleFg}"/>
        </Border>
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="busy">
          <Setter TargetName="badge" Property="Background" Value="{DynamicResource BusyBg}"/>
          <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource BusyFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="done">
          <Setter TargetName="badge" Property="Background" Value="{DynamicResource OkBg}"/>
          <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource OkFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="fail">
          <Setter TargetName="badge" Property="Background" Value="{DynamicResource ErrBg}"/>
          <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource ErrFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="skip">
          <Setter TargetName="badge" Property="Background" Value="{DynamicResource WarnBg}"/>
          <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource WarnFg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <!-- ══════════ 본문 ══════════ -->
  <Grid>
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ── 상단: 액션 + 옵션 ── -->
      <Border Grid.Row="0" CornerRadius="10" Padding="14"
              Background="{DynamicResource CardBg}"
              BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
        <StackPanel>

          <Grid>
            <!-- 주요 동작은 왼쪽에, 되돌릴 수 없는 [목록 비우기]는 오른쪽 끝에 떨어뜨려 배치 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button x:Name="BtnAdd" Style="{StaticResource GhostButton}"
                      AutomationProperties.Name="파일 추가">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,7,0"/>
                  <TextBlock Text="파일 추가" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnConvert" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                      AutomationProperties.Name="PDF 변환">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="15" Margin="0,0,8,0"/>
                  <TextBlock Text="PDF 변환" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <Button x:Name="BtnClear" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    AutomationProperties.Name="목록 비우기">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,7,0"/>
                <TextBlock Text="목록 비우기" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,14,0,0"/>

          <WrapPanel Margin="0,14,0,0">
            <CheckBox x:Name="ChkOverwrite" Style="{StaticResource Toggle}"
                      Content="기존 PDF 덮어쓰기" Margin="0,0,24,0"/>
            <CheckBox x:Name="ChkUseSaved" Style="{StaticResource Toggle}"
                      Content="현재 저장된 PDF 설정으로 출력"/>
          </WrapPanel>

          <Grid Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="ChkOutFolder" Grid.Column="0" Style="{StaticResource Toggle}"
                      Content="출력 폴더 선택" VerticalAlignment="Center"/>

            <Button x:Name="BtnPickFolder" Grid.Column="1" Style="{StaticResource GhostButton}"
                    Margin="16,0,0,0" Padding="12,7" IsEnabled="False"
                    AutomationProperties.Name="폴더 선택">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,7,0"/>
                <TextBlock Text="폴더 선택" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Border x:Name="OutPathBox" Grid.Column="2" Margin="10,0,0,0" CornerRadius="6" Padding="11,8"
                    Background="{DynamicResource InputBg}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
              <TextBlock x:Name="TxtOutPath" Text="선택된 폴더 없음" FontSize="12"
                         Foreground="{DynamicResource FgSubtle}" TextTrimming="CharacterEllipsis"/>
            </Border>
          </Grid>

        </StackPanel>
      </Border>

      <!-- ── 가운데: 파일 목록 / 빈 상태 ── -->
      <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="10" Padding="7"
              Background="{DynamicResource CardBg}"
              BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
        <Grid>
          <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Padding="0"
                   SelectionMode="Extended"
                   ItemContainerStyle="{StaticResource FileRow}"
                   ItemTemplate="{StaticResource FileTemplate}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

          <Grid x:Name="EmptyState" IsHitTestVisible="False" Margin="6">
            <Rectangle RadiusX="10" RadiusY="10" Fill="Transparent"
                       Stroke="{DynamicResource DropBorder}" StrokeThickness="1.5" StrokeDashArray="5 4"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="46"
                         HorizontalAlignment="Center" Foreground="{DynamicResource FgSubtle}"/>
              <TextBlock Text="여기에 HWP · HWPX 파일이나 폴더를 끌어다 놓으세요"
                         Margin="0,14,0,0" HorizontalAlignment="Center"
                         Foreground="{DynamicResource FgMuted}"/>
              <TextBlock Text="또는 [파일 추가] 버튼을 누르세요" FontSize="11.5"
                         Margin="0,5,0,0" HorizontalAlignment="Center"
                         Foreground="{DynamicResource FgSubtle}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- ── 하단: 상태 + 진행률 + 로그 ── -->
      <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="10" Padding="14,12"
              Background="{DynamicResource CardBg}"
              BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
        <StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 회전 스피너 (변환 중에만 표시) -->
            <Ellipse x:Name="Spinner" Grid.Column="0" Width="16" Height="16" Margin="0,0,9,0"
                     Visibility="Collapsed" VerticalAlignment="Center"
                     Stroke="{DynamicResource Accent}" StrokeThickness="2"
                     StrokeDashArray="2.2 1.6" StrokeDashCap="Round"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <RotateTransform Angle="0"/>
              </Ellipse.RenderTransform>
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:1.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>

            <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="준비됨" VerticalAlignment="Center"
                       Foreground="{DynamicResource FgMuted}" TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="TxtCount" Grid.Column="2" Text="" VerticalAlignment="Center"
                       FontSize="11.5" FontWeight="SemiBold" Margin="12,0,0,0"
                       Foreground="{DynamicResource FgSubtle}"/>
          </Grid>

          <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Margin="0,10,0,0"
                       Minimum="0" Maximum="100" Value="0"/>

          <TextBox x:Name="Log" Height="78" Margin="0,11,0,0" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" Padding="0"
                   BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>

        </StackPanel>
      </Border>
    </Grid>

    <!-- ── 드래그 오버레이 ── -->
    <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
            Background="{DynamicResource DropOverlayBg}" Margin="10" CornerRadius="12"
            BorderBrush="{DynamicResource Accent}" BorderThickness="2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="52"
                   HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
        <TextBlock Text="놓으면 목록에 추가됩니다" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
